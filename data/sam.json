  "nodes": {
    "s1": {
      "id": "s1",
      "label": "茶水間 22:40",
      "text": "微波爐叮一聲。Sammi 把兩個杯麵推過來，笑得唔似加班。\n\n「潛規則第一條：餓嘅人簽錯字。食完先罵老闆。」",
      "thought": "暖光。同 Vera 那種冷完全相反。",
      "aside": "影印聲遠咗。",
      "mid": "杯麵熱氣繞住佢指尖。蒸汽在燈光下轉圈。匙羹輕輕敲碗邊一下。",
      "choices": [
        {"label": "「你成日咁留？」", "next": "s2a", "heat": 6},
        {"label": "「教第二條。」", "next": "s2b", "heat": 4, "tension": 4},
        {"label": "「我食完就走。」", "next": "s2c", "tension": 6}
      ]
    },
    "s2a": {
      "id": "s2a",
      "remember": ["sam_watches"],
      "label": "留夜原因",
      "text": "「唔係勤力。」Sammi 吹麵。「係有人未走，我唔放心把你丟係樓上。」",
      "thought": "樓上兩字忽然好遠。",
      "aside": "杯麵熱氣散開。",
      "mid": "吹麵時，佢望你一眼就移開。匙羹在碗邊停半拍。蒸汽遮住半邊臉。",
      "choices": [
        {"label": "「樓上係指邊個？」", "next": "s2x", "tension": 8},
        {"label": "「……多謝你留。」", "next": "s2x", "heat": 10}
      ]
    },
    "s2b": {
      "id": "s2b",
      "remember": ["heard_rule_two"],
      "label": "第二條",
      "text": "「第二條：讚你好，同想你好，係兩件事。」Sammi 頓一頓。「我偏後者。麻煩。」",
      "thought": "麻煩兩字落得好重。",
      "aside": "笑裏帶重。",
      "mid": "頓一頓之後，匙羹停在空中。熱氣仍在，空氣靜。碗邊水珠滑落。",
      "choices": [
        {"label": "「幾麻煩？」", "next": "s2x", "heat": 10},
        {"label": "「當我未聽過。」", "next": "s2x", "tension": 6}
      ]
    },
    "s2c": {
      "id": "s2c",
      "label": "想走",
      "text": "Sammi 點頭，卻把匙羹放慢。\n\n「走得。門禁 23:15 之後要拍卡兩次。第一次我幫你。第二次——你自己想清楚。」",
      "thought": "第二次留給你。",
      "aside": "匙羹停半拍。",
      "mid": "匙羹放慢時，熱氣仍在。佢手指在杯沿輕敲。敲聲同心跳差半拍。",
      "choices": [
        {"label": "「我再坐陣。」", "next": "s2x", "heat": 8},
        {"label": "「我真走。」", "next": "ending_s_c"}
      ]
    },
    "s2x": {
      "id": "s2x",
      "label": "影印機後",
      "text": "Sammi 帶你過影印機。\n\n「未到樓梯。你而家返工位，我當你食完麵。」",
      "thought": "又係一次可以走嘅門。",
      "aside": "紅燈一閃就熄。",
      "mid": "影印機紅燈一閃，影子拉長。紙張味道混住熱氣。影子在牆上停半秒。",
      "choices": [
        {"label": "「帶路。」", "next": "s3", "heat": 8},
        {"label": "「我返工位。」", "next": "ending_s_c"},
        {"label": "「影印機後有冇第三條？」", "next": "s2y", "heat": 8, "tension": 4, "cg": true}
      ]
    },
    "s2y": {
      "id": "s2y",
      "label": "第三條",
      "text": "Sammi 低聲：「第三條：有人問規則，代表已經想知答案。答案喺樓梯。」",
      "thought": "答案同規則，分兩邊。",
      "aside": "紅燈再閃一下。",
      "mid": "低聲時，呼吸近咗半格。影子在牆上重疊。紅燈映在工牌上。",
      "choices": [
        {"label": "「帶我去。」", "next": "s3", "heat": 12, "cg": true},
        {"label": "「我返工位。」", "next": "ending_s_c"}
      ]
    },
    "s3": {
      "id": "s3",
      "mode": "call",
      "label": "天台通道",
      "text": "Sammi 帶你去樓梯。\n\n「呢度監控盲區。唔係叫你做壞事。係叫你知，公司永遠有人睇住——除咗呢五級樓梯。」",
      "thought": "五級樓梯變成秘密入口。",
      "aside": "風把工牌繩吹斜。",
      "mid": "風吹過，工牌繩擦你手。階梯冷光只照到第三級。風聲蓋過遠處影印機。",
      "choices": [
        {"label": "（靠近）「咁你睇住我？」", "next": "s4", "heat": 14, "remember": ["asked_watch"]},
        {"label": "「帶我返工位。」", "next": "s4", "tension": 4},
        {"label": "「呢種秘密我唔想要。」", "next": "ending_s_c"},
        {"label": "「五級之後仲有咩？」", "next": "s3z", "heat": 10, "cg": true}
      ]
    },
    "s3z": {
      "id": "s3z",
      "label": "五級之後",
      "text": "Sammi 停步，側身。\n\n「之後就係天台門。鎖壞咗半年，無人修。你要知，定要走？」",
      "thought": "鎖壞同秘密，一樣耐。",
      "aside": "風更大。",
      "mid": "天台門縫透出夜風。佢手按在門把上，未推。工牌繩再晃一下。",
      "choices": [
        {"label": "「我想知。」", "next": "s4", "heat": 13, "cg": true},
        {"label": "「返工位。」", "next": "ending_s_c"}
      ]
    },
    "s4": {
      "id": "s4",
      "label": "深夜之後",
      "text": "Sammi 聲線第一次唔笑：\n\n「我可以只做前輩。都可以……唔只係。」",
      "thought": "選擇權在你。",
      "aside": "防火門冷。",
      "mid": "聲線一變，走廊靜得只剩風。工牌繩輕輕擺。呼吸差半拍就近。",
      "choices": [
        {"label": "「唔只係。」", "next": "s5", "heat": 16, "requireHeat": 32},
        {"label": "「只做前輩。」", "next": "ending_s_c", "tension": 2},
        {"label": "「我想慢慢嚟。」", "next": "ending_s_b", "heat": 8, "remember": ["go_slow"]},
        {"label": "「你決定。」", "next": "s4y", "heat": 12, "cg": true}
      ]
    },
    "s4y": {
      "id": "s4y",
      "label": "交決定",
      "text": "Sammi 停住，望你一眼。\n\n「你交我？咁我揀……慢慢，但唔退。」",
      "thought": "慢慢同唔退，同時成立。",
      "aside": "門縫風入。",
      "mid": "佢手仍按門把。夜風把工牌繩吹過你腕。呼吸再近半格。",
      "choices": [
        {"label": "「得。」", "next": "s5", "heat": 14, "requireHeat": 30, "cg": true},
        {"label": "「我返工位。」", "next": "ending_s_c"}
      ]
    },
    "s5": {
      "id": "s5",
      "label": "門後",
      "text": "Sammi 額抵住你額。\n\n「聽日我照幫你改 slide。呢頁，寫唔入共享文件。」",
      "thought": "共享文件以外先有位置。",
      "aside": "只有你哋兩個。",
      "mid": "額抵額時，呼吸同步半拍。夜風從門縫入。工牌繩輕輕夾在中間。",
      "choices": [
        {"label": "「我知。」", "next": "ending_s_a", "heat": 8, "requireHeat": 40}
      ]
    },
    "ending_s_a": {
      "id": "ending_s_a",
      "ending": true,
      "endingTitle": "深夜同盟",
      "text": "辦公室照舊。茶水間杯麵多開一格。",
      "aside": "熱氣仍在。",
      "mid": "同盟唔寫入文件，只留熱氣。杯麵香味還在。"
    },
    "ending_s_b": {
      "id": "ending_s_b",
