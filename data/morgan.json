{
  "id": "morgan",
  "name": "Elise",
  "title": "客戶負責人",
  "hook": "大單前夜，酒廊「只係傾生意」。",
  "start": "m1",
  "portrait": "./assets/morgan.jpg",
  "tint": "amber",
  "chatName": "Elise",
  "nodes": {
    "m1": {
      "id": "m1",
      "label": "酒廊 21:10",
      "text": "落地玻璃外係維港夜燈。Elise 轉酒杯，戒指敲一下杯壁。\n\n「合約數字我哋日頭講完。夜晚……講人。」",
      "thought": "佢望住你，唔望海。",
      "aside": "爵士樂壓得好低。",
      "mid": "杯沿反光掠過佢眼。酒杯轉半圈，像在等你開標。燈光落在戒指上，一閃。指尖在杯壁停兩秒，像在量距離。杯底餘溫仍在，爵士樂低音慢慢推近。呼吸差半拍就近。杯壁再轉半圈，燈光再跳。指尖溫度隱約傳過桌面，酒氣再近一寸。燈光再掠過戒指一次，距離再縮半分。杯沿再反光半秒，熱度未散。呼吸再差半拍。溫度再傳半分。目光再鎖半秒。空氣再靜一分。餘溫未散。",
      "choices": [
        {"label": "「人同單，邊樣先成交？」", "next": "m2a", "heat": 8, "tension": 6, "cg": true},
        {"label": "「我嚟係收條款。」", "next": "m2b", "tension": 10},
        {"label": "（坐近一格）「你想聽邊種答案？」", "next": "m2c", "heat": 14, "tension": 4, "cg": true}
      ]
    },
    "m2a": {
      "id": "m2a",
      "label": "開標",
      "text": "Elise 笑得淡。「成交？你先講你想要邊樣。人，定條款。」",
      "thought": "開標權交返你。",
      "aside": "杯壁再敲一聲。",
      "mid": "佢指尖停杯沿。目光唔移。等待比酒更濃。",
      "choices": [
        {"label": "「兩者都要。」", "next": "m3a", "heat": 10, "cg": true},
        {"label": "「先條款。」", "next": "m3b", "tension": 6}
      ]
    },
    "m2b": {
      "id": "m2b",
      "label": "收條款",
      "text": "「條款？得。你推紙過嚟。我簽之前，你要先答一條。」",
      "thought": "紙喺中間，人喺對面。",
      "aside": "筆帽未開。",
      "choices": [
        {"label": "「問。」", "next": "m3b", "tension": 8},
        {"label": "（推近）「你先講你想要咩。」", "next": "m3a", "heat": 12, "cg": true}
      ]
    },
    "m2c": {
      "id": "m2c",
      "label": "坐近",
      "text": "「你坐近，我當你已經答咗一半。」Elise 轉杯，目光落在你手。",
      "thought": "距離縮咗，規則未寫。",
      "aside": "爵士低音再近一格。",
      "mid": "杯沿再反光。指尖溫度傳過桌。",
      "choices": [
        {"label": "「另一半你講。」", "next": "m3a", "heat": 12, "cg": true},
        {"label": "「我只係坐近聽清楚。」", "next": "m3b", "tension": 4}
      ]
    },
    "m3a": {
      "id": "m3a",
      "label": "兩者",
      "text": "「好膽。大單前夜，人同條款一齊要。」Elise 指尖輕點你手背。",
      "thought": "點一下，比簽字重。",
      "aside": "窗外燈火慢閃。",
      "mid": "指尖停半秒。熱度未散。目光鎖住。",
      "choices": [
        {"label": "「點完就簽？」", "next": "m4a", "heat": 10, "cg": true},
        {"label": "「再近啲講。」", "next": "m4b", "heat": 14, "cg": true},
        {"label": "「我只簽紙。」", "next": "m4c", "tension": 8}
      ]
    },
    "m3b": {
      "id": "m3b",
      "label": "先條款",
      "text": "「條款清楚。人呢？你仲未答。」Elise 把筆推到你面前。",
      "thought": "筆比問題更近。",
      "aside": "杯底餘溫。",
      "choices": [
        {"label": "「人可以後補。」", "next": "m4c", "tension": 6},
        {"label": "「人而家補。」", "next": "m4b", "heat": 12, "cg": true}
      ]
    },
    "m4a": {
      "id": "m4a",
      "label": "點完簽",
      "text": "「簽之前，你量一次溫度。」Elise 把你手拉到玻璃。",
      "thought": "玻璃涼，手熱。",
      "aside": "霧開始起。",
      "mid": "指尖對指尖。涼同熱分開計。",
      "choices": [
        {"label": "「量完。」", "next": "m5v", "heat": 12, "cg": true},
        {"label": "「夠喇，簽。」", "next": "ending_m_c", "tension": 4}
      ]
    },
    "m4b": {
      "id": "m4b",
      "label": "再近",
      "text": "「再近？酒廊監控只覆大堂，唔覆呢角。」Elise 聲低。",
      "thought": "角位比合約安全。",
      "aside": "爵士蓋過呼吸。",
      "mid": "距離再縮。熱度蓋過酒氣。",
      "choices": [
        {"label": "「量溫度。」", "next": "m5v", "heat": 14, "cg": true},
        {"label": "「簽完再近。」", "next": "m4a", "heat": 8}
      ]
    },
    "m4c": {
      "id": "m4c",
      "label": "只簽紙",
      "text": "「明智。紙簽完，人當未傾。」Elise 收回手。",
      "thought": "距離重新拉開。",
      "aside": "筆帽蓋返。",
      "choices": [
        {"label": "「下晝見。」", "next": "ending_m_c", "tension": 4},
        {"label": "「……再傾一次人。」", "next": "m4b", "heat": 10, "cg": true}
      ]
    },
    "m5v": {
      "id": "m5v",
      "label": "玻璃涼",
      "text": "Elise 指尖輕觸玻璃。\n\n「涼？你自己量。量完就唔好再問溫度。」",
      "thought": "涼同熱，分開計。",
      "aside": "玻璃上霧再濃。",
      "mid": "佢指尖停玻璃上。涼意同餘溫同時傳到。窗外燈火再暗半格。呼吸差半拍。目光鎖住你，等你先動。霧再擴。涼意再傳半分。燈火再暗，熱度蓋過涼。霧再濃半分，決定落在指尖。呼吸再同步，熱度再升。",
      "choices": [
        {"label": "「我量完。簽。」", "next": "ending_m_a", "heat": 14, "requireHeat": 35, "cg": true},
        {"label": "「夠喇。」", "next": "ending_m_c", "tension": 4},
        {"label": "「量完……再量一次。」", "next": "ending_m_b", "heat": 16, "requireHeat": 40, "cg": true}
      ]
    },
    "ending_m_a": {
      "id": "ending_m_a",
      "ending": true,
      "endingTitle": "成交・人同單",
      "text": "Elise：「合約準時。其他——酒廊當未發生。」"
    },
    "ending_m_b": {
      "id": "ending_m_b",
      "ending": true,
      "endingTitle": "再量一次",
      "text": "Elise：「溫度你自己記得。下晝紙上見。」"
    },
    "ending_m_c": {
      "id": "ending_m_c",
      "ending": true,
      "endingTitle": "只簽紙",
      "text": "Elise：「條款齊。人……下次再傾。」"
    }
  }
}
