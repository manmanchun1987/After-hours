    },
    "m2c": {
      "id": "m2c",
      "label": "靠近",
      "mode": "call",
      "text": "距離縮短之後，香水同威士忌一齊近。\n\n「危險答案。」Morgan 聲好輕。「我鍾意危險，但唔鍾意賴帳。」",
      "remember": [
        "sat_closer"
      ],
      "choices": [
        {
          "label": "「我唔賴。」",
          "next": "m3",
          "heat": 12
        },
        {
          "label": "「……當我衝動。」",
          "next": "m3",
          "heat": 6,
          "tension": 6
        }
      ]
    },
    "m3": {
      "id": "m3",
      "label": "房間卡",
      "text": "帳單來。Morgan 唔望價錢，只把一張房卡推到中間。\n\n「樓上有安靜位。簽唔簽，你決定。」",
      "choices": [
