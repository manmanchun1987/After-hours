    "m1": {
      "id": "m1",
      "label": "酒廊 21:10",
      "text": "落地玻璃外係維港夜燈。Morgan 轉酒杯，戒指敲一下杯壁。\n\n「合約數字我哋日頭講完。夜晚……講人。」",
      "thought": "佢望住你，唔望海。",
      "aside": "爵士樂壓得好低，似專門留位畀秘密。",
      "choices": [
        {
          "label": "「人同單，邊樣先成交？」",
          "next": "m2a",
          "heat": 8,
          "tension": 6
        },
        {
          "label": "「我嚟係收條款。」",
          "next": "m2b",
          "heat": 0,
          "tension": 10
        },
        {
          "label": "（坐近一格）「你想聽邊種答案？」",
          "next": "m2c",
          "heat": 14,
          "tension": 4
        }
      ]
    },
    "m2a": {
      "id": "m2a",
      "label": "交易口吻",
      "text": "Morgan 笑得短。\n\n「聰明。單可以假寐，人唔可以。你今晚代表公司，定代表你自己？」",
      "remember": [
        "named_the_deal"
      ],
      "choices": [
        {
          "label": "「代表我想贏。」",
          "next": "m3",
          "heat": 10
        },
        {
          "label": "「代表公司。其他唔講。」",
          "next": "m3",
          "tension": 8
        }
      ]
    },
    "m2b": {
      "id": "m2b",
      "label": "收條款",
      "text": "「悶。」Morgan 靠後。「不過悶嘅人，有時最穩。」",
      "remember": [
        "kept_professional"
      ],
      "choices": [
        {
          "label": "「線唔好再伸。」",
          "next": "m3",
          "tension": 10
