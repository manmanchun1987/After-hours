      "label": "走廊 23:44",
      "scene": "office",
      "text": "尾班電梯門開過一次。你無入。\n\nVera 隔住門：「入嚅。唔好喇走廊度扮嘢。」",
      "thought": "佢知你仲未走。",
      "aside": "監控紅點照住你後腦。",
      "choices": [
        {"label": "推門", "next": "n0b"},
        {"label": "（停一秒）再推", "next": "n0b", "tension": 2}
      ],
      "freeChat": true,
      "intents": [
        {"keys": ["推門", "推开门", "推開門", "開門", "开门", "入去", "入嚅", "進去", "进去", "推入", "入門", "入门"], "next": "n0b", "bucket": "leave", "ack": "……門把凉。你推。"},
        {"keys": ["猶豫", "犹豫", "停一秒", "停一停", "唔敢", "再推", "等等", "企喇度", "站住", "停"], "next": "n0b", "tension": 2, "bucket": "tired", "ack": "……你停過。我知。入嚅。"},
        {"keys": ["鎖門", "关门", "關門", "唔入", "不进", "不進", "走先", "閃"], "next": "n0b", "tension": 1, "bucket": "leave", "ack": "走廊燈亮住。你最終都會推。"}
      ]
    },
    "n0b": {
      "id": "n0b",
      "label": "門後",
      "scene": "office",
      "remember": ["door_shut"],
      "text": "門喇你背後噁一聲。Vera 唔望你。\n\n「鎖唔鎖唔重要。重要係你推門之前已經知道結果。」",
      "thought": "Deadline 未到，「結果」兩個字已經落地。",
      "aside": "門縫消失。",
      "choices": [{"label": "走去桌前", "next": "n1"}]
    },
    "n1": {
      "id": "n1",
      "label": "週五 23:47",
      "scene": "office",
      "text": "你將簡報推去 Vera 面前。佢指節敲兩下桌。\n\n「你自己都知呢份嘢……未夠。」",
      "thought": "今晚你走唔到。",
      "aside": "錶針幾乎停。",
      "choices": [
        {"label": "「我可以而家改。」", "next": "n2a"},
        {"label": "「邊部分未夠？講清楚。」", "next": "n2b", "tension": 6},
        {"label": "（站近）「你特登留到而家先講？」", "next": "n2c", "heat": 8, "cg": true}
      ]
    },
    "n2a": {
      "id": "n2a",
      "remember": ["stayed_late"],
      "label": "配合",
      "scene": "office",
      "text": "Vera 拉椅到你側邊。「坐低。我講，你改。唔好打斷。」",
      "thought": "距離近到聽得見呼吸。",
      "aside": "袖口冷香水擦過手腕。",
      "choices": [
        {"label": "「……係，我聽緊。」", "next": "n3a"},
        {"label": "（對視）「你咁近，我改唔到字。」", "next": "n3b", "heat": 8, "cg": true}
      ]
    },
    "n2b": {
      "id": "n2b",
      "mode": "call",
      "remember": ["pushed_back"],
      "label": "頂嘴",
      "scene": "office",
      "text": "Vera 笑得唔似笑。「你想要『清楚』？得。過嚟。」",
      "thought": "頂嘴？有趣。",
      "aside": "筆尖停喇空白行。",
      "choices": [
        {"label": "（行過去）", "next": "n3c"},
        {"label": "「……你講，我聽。」", "next": "n3a", "heat": 6}
      ]
    },
    "n2c": {
      "id": "n2c",
      "remember": ["got_close"],
      "label": "試探",
      "scene": "office",
      "text": "「大膽。今晚……我可以例外。」",
      "thought": "例外兩個字比評語重。",
      "aside": "呼吸擦過耳側。",
      "choices": [
        {"label": "（再近啲）", "next": "n3b", "heat": 8, "cg": true},
        {"label": "「我專心改。」", "next": "n3a"}
      ]
    },
    "n3a": {
      "id": "n3a",
      "label": "克制",
      "scene": "office",
      "text": "指尖碰上。「手震。驚我，定驚你自己？」",
      "thought": "控制權仍然喇佢度。",
      "aside": "螢幕藍光拉長影子。",
      "mid": "佢指尖停半秒。",
      "choices": [
        {"label": "「驚交唔到差。」", "next": "n4a"},
        {"label": "「……你話呢？」", "next": "n4b", "heat": 8, "cg": true}
      ]
    },
    "n3b": {
      "id": "n3b",
      "mode": "call",
      "label": "臨界",
      "scene": "office",
      "text": "「公司監控得走廊有鏡頭，呢間無。」",
      "thought": "邀請同命令，差喇語氣。",
      "aside": "監控紅點眼躁一下。",
      "mid": "佢語氣平，好似已經算定你會留。",
      "choices": [
        {"label": "「所以你先留我？」", "next": "n4b", "heat": 8, "cg": true},
        {"label": "「我仲係員工。」", "next": "n4a"},
        {"label": "（主動拉近）", "next": "n4c", "heat": 10, "cg": true}
      ]
    },
    "n3c": {
      "id": "n3c",
      "label": "靠近",
      "scene": "office",
      "text": "「你要清楚嘅係簡報，定係我想對你點？」",
      "thought": "要清楚？靠近講。",
      "aside": "問句落喇桌面。",
      "choices": [
        {"label": "「兩樣都要。」", "next": "n4b", "heat": 8, "cg": true},
        {"label": "「只要簡報。」", "next": "n4a", "tension": 4}
      ]
    },
    "n4a": {
      "id": "n4a",
      "label": "抽身",
      "scene": "office",
      "text": "「明智。檔案丟 shared drive。下星期一評核——我記得。」",
      "thought": "記得兩個字比承諾長。",
      "aside": "電梯燈亮一下又熄。",
      "choices": [{"label": "離開", "next": "ending_c", "tension": 4}]
    },
    "n4b": {
      "id": "n4b",
      "mode": "call",
      "remember": ["chose_stay"],
      "label": "承認",
      "scene": "office",
      "text": "手指抬起你下巴。「留低，就唔好再扮只係改簡報。」",
      "thought": "唔好再扮公事。",
      "aside": "燈管微顎。",
      "mid": "下巴被抬高，規矩已經唔同。",
      "choices": [
        {"label": "留低", "next": "n4x", "heat": 8, "cg": true},
        {"label": "離開", "next": "ending_c"}
      ]
    },
    "n4x": {
      "id": "n4x",
      "mode": "call",
      "label": "燈揯",
      "scene": "office",
      "text": "Vera 走去牆邊，手按喇揯上，未推落。\n\n「最後一次問。燈熄之後，你就唔好話自己唔知。」",
      "thought": "揯仲未落。你仲可以走。",
      "aside": "燈管聲細過呼吸。",
      "choices": [
        {"label": "「熄。」", "next": "n5", "heat": 6, "cg": true},
        {"label": "「我收回。」", "next": "ending_c"}
      ]
    },
    "n4c": {
      "id": "n4c",
      "label": "你主動",
      "scene": "office",
      "text": "「記住。係你先開始。」",
      "thought": "再唔係單方面。",
      "aside": "簡報白光一跳。",
      "choices": [{"label": "繼續", "next": "n4x", "heat": 8, "cg": true}]
    },
