{
  "id": "alex",
  "name": "Vera",
  "title": "部門主管",
  "hook": "Deadline 可以改。態度唔可以。",
  "start": "n1",
  "nodes": {
    "n1": {
      "id": "n1",
      "label": "週五 23:47",
      "text": "整層只剩會議室燈。你將簡報推去 Vera 面前。佢指節敲兩下桌。\n\n「你自己都知呢份嘢……未夠。」",
      "thought": "今晚你走唔到。空氣似凍過空調。」",
      "aside": "影印機燈一閃。錶針幾乎停。",
      "choices": [
        {
          "label": "「我可以而家改。」",
          "next": "n2a"
        },
        {
          "label": "「邊部分未夠？講清楚。」",
          "next": "n2b",
          "tension": 6
        },
        {
          "label": "（站近）「你特登留到而家先講？」",
          "next": "n2c",
          "heat": 8
        }
      ]
    },
    "n2a": {
      "id": "n2a",
      "label": "配合",
      "remember": [
        "stayed_late"
      ],
      "text": "Vera 拉椅到你側邊，袖口冷香水擦過手腕。\n\n「坐低。我講，你改。唔好打斷。」",
      "thought": "距離近到聽得見呼吸節奏。」",
      "choices": [
        {
          "label": "「……係，我聽緊。」",
          "next": "n3a"
        },
        {
          "label": "（對視）「你咁近，我改唔到字。」",
          "next": "n3b",
          "heat": 8
        }
      ]
    },
    "n2b": {
      "id": "n2b",
      "label": "頂嘴",
      "mode": "call",
      "remember": [
        "pushed_back"
      ],
      "text": "Vera 笑得唔似笑。\n\n「你想要『清楚』？得。過來。」",
      "aside": "筆尖停在空白行，似等你先動。」",
      "choices": [
        {
          "label": "（行過去）",
          "next": "n3c"
        },
        {
          "label": "「……你講，我聽。」",
          "next": "n3a",
          "heat": 6
        }
      ]
    },
    "n2c": {
      "id": "n2c",
      "label": "試探",
      "remember": [
        "got_close"
      ],
      "text": "「大膽。今晚……我可以例外。」呼吸擦過耳側。",
      "thought": "例外兩字比任何評語都重。」",
      "choices": [
        {
          "label": "（再近啲）",
          "next": "n3b",
          "heat": 8
        },
        {
          "label": "「我專心改。」",
          "next": "n3a"
        }
      ]
    },
    "n3a": {
      "id": "n3a",
      "label": "克制",
      "text": "你們改簡報。伸手擱杯時指尖碰上。\n\n「手震。驚我，定驚你自己？」",
      "aside": "螢幕藍光把兩人影子拉長。",
      "choices": [
        {
          "label": "「驚交唔到差。」",
          "next": "n4a"
        },
        {
          "label": "「……你話呢？」",
          "next": "n4b",
          "heat": 8
        }
      ]
    },
    "n3b": {
      "id": "n3b",
      "label": "臨界",
      "mode": "call",
      "text": "「公司監控只覆走廊，唔覆呢間。」唔係威脅，係邀請。",
      "thought": "邀請同命令，差在語氣。」",
      "choices": [
        {
          "label": "「所以你先留我？」",
          "next": "n4b",
          "heat": 8
        },
        {
          "label": "「我仲係員工。」",
          "next": "n4a"
        },
        {
          "label": "（主動拉近）",
          "next": "n4c",
          "heat": 10
        }
      ]
    },
    "n3c": {
      "id": "n3c",
      "label": "靠近",
      "text": "「你要清楚嘅係簡報，定係我想對你點？」",
      "aside": "問句落在桌面，似多一張空白頁。」",
      "choices": [
        {
          "label": "「兩者都要。」",
          "next": "n4b",
          "heat": 8
        },
        {
          "label": "「只要簡報。」",
          "next": "n4a",
          "tension": 4
        }
      ]
    },
    "n4a": {
      "id": "n4a",
      "label": "抽身",
      "text": "「明智。檔案丟 shared drive。下週一評核——我記得。」",
      "thought": "記得兩字，比任何承諾都長。」",
      "choices": [
        {
          "label": "離開",
          "next": "ending_c",
          "tension": 4
        }
      ]
    },
    "n4b": {
      "id": "n4b",
      "label": "承認",
      "mode": "call",
      "remember": [
        "chose_stay"
      ],
      "text": "手指抬起你下巴。\n\n「留低，就唔好再扮只係改簡報。」",
      "aside": "燈管微顫，像替你答。",
      "choices": [
        {
          "label": "留低",
          "next": "n5",
          "heat": 8
        },
        {
          "label": "離開",
          "next": "ending_c"
        }
      ]
    },
    "n4c": {
      "id": "n4c",
      "label": "你主動",
      "text": "「記住。係你先開始。」",
      "thought": "開始之後，就再唔係單方面。",
      "choices": [
        {
          "label": "繼續",
          "next": "n5",
          "heat": 8
        }
      ]
    },
    "n5": {
      "id": "n5",
      "label": "燈關之後",
      "mode": "call",
      "text": "燈暗。規則喺佢度——但要你親口講想要咩。",
      "aside": "黑暗裡只剩呼吸同錶聲。",
      "choices": [
        {
          "label": "「你話點就點。」",
          "next": "n6a",
          "heat": 8,
          "requireHeat": 36
        },
        {
          "label": "「平等。今晚先。」",
          "next": "n6b",
          "heat": 8
        },
        {
          "label": "「你早計劃今晚。」",
          "next": "n6c",
          "tension": 8
        }
      ]
    },
    "n6a": {
      "id": "n6a",
      "label": "交出控制",
      "text": "每一次升級前佢都問：「仲可唔可以？」權力來自秩序。",
      "thought": "秩序比衝動更危險。",
      "choices": [
        {
          "label": "迎向天亮",
          "next": "ending_a"
        }
      ]
    },
    "n6b": {
      "id": "n6b",
      "label": "對等",
      "remember": [
        "wanted_equal"
      ],
      "text": "「評核表……唔會寫呢頁。」",
      "aside": "秘密比分數更耐存。",
      "choices": [
        {
          "label": "迎向天亮",
          "next": "ending_b"
        }
      ]
    },
    "n6c": {
      "id": "n6c",
      "label": "拆穿",
      "remember": [
        "called_out_plan"
      ],
      "text": "deadline 可以早講。佢擇今晚。「仲留唔留？」",
      "thought": "選擇權忽然回到你手。",
      "choices": [
        {
          "label": "「留。」",
          "next": "ending_a",
          "heat": 8
        },
        {
          "label": "「走。」",
          "next": "ending_c"
        }
      ]
    },
    "ending_a": {
      "id": "ending_a",
      "ending": false,
      "label": "天亮",
      "text": "「簡報。一小時內。其他——當唔發生。」",
      "choices": [
        {
          "label": "去週一評核室",
          "next": "n7",
          "heat": 6
        },
        {
          "label": "到此為止",
          "next": "ending_a_lock"
        }
      ]
    },
    "ending_b": {
      "id": "ending_b",
      "ending": false,
      "label": "同盟",
      "text": "「你呢晚表現……離職信我都可能批。」",
      "choices": [
        {
          "label": "去週一評核室",
          "next": "n7",
          "heat": 6
        },
        {
          "label": "到此為止",
          "next": "ending_b_lock"
        }
      ]
    },
    "ending_c": {
      "id": "ending_c",
      "ending": true,
      "label": "結局 C",
      "endingTitle": "抽身",
      "text": "走廊好長。電話：Vera「檔案我等。」"
    },
    "ending_a_lock": {
      "id": "ending_a_lock",
      "ending": true,
      "label": "結局 A",
      "endingTitle": "越界・規則內",
      "text": "評核室的門，你今次唔推開。"
    },
    "ending_b_lock": {
      "id": "ending_b_lock",
      "ending": true,
      "label": "結局 B",
      "endingTitle": "對等一晚",
      "text": "秘密同盟。評核室可以下週再去。"
    },
    "n7": {
      "id": "n7",
      "label": "週一評核室",
      "mode": "call",
      "remember": [
        "review_room"
      ],
      "text": "百葉簾拉死。空白評核表壓住你手背。\n\n「上週五。寫定性，定寫量化？」",
      "aside": "筆帽咔一聲，像倒數。",
      "choices": [
        {
          "label": "「寫你想寫嘅。」",
          "next": "n8a",
          "heat": 10,
          "requireHeat": 40
        },
        {
          "label": "「寫事實。包括你留我。」",
          "next": "n8b",
          "tension": 12,
          "requireHeat": 28
        },
        {
          "label": "「當唔發生。」",
          "next": "ending_d"
        }
      ]
    },
    "n8a": {
      "id": "n8a",
      "label": "交權",
      "text": "評語：可造。「我會再留。你怕唔怕？」",
      "thought": "怕同想，原來可以並存。",
      "choices": [
        {
          "label": "「怕。但我留。」",
          "next": "ending_e",
          "heat": 12,
          "requireHeat": 50
        },
        {
          "label": "「所以我走。」",
          "next": "ending_d"
        }
      ]
    },
    "n8b": {
      "id": "n8b",
      "label": "寫事實",
      "mode": "call",
      "text": "「我可以毀你，都可以抬你。你擇。」",
      "aside": "選擇落在紙上，比簽字更重。",
      "choices": [
        {
          "label": "「抬我。對等。」",
          "next": "ending_e",
          "heat": 8,
          "requireHeat": 45
        },
        {
          "label": "「你毀唔到我。」",
          "next": "ending_f",
          "tension": 14,
          "requireHeat": 30
        }
      ]
    },
    "ending_d": {
      "id": "ending_d",
      "ending": true,
      "label": "結局 D",
      "endingTitle": "白紙",
      "text": "「聰明。無趣。」那晚唔入檔。"
    },
    "ending_e": {
      "id": "ending_e",
      "ending": true,
      "label": "結局 E",
      "endingTitle": "評核室規則",
      "text": "辦公室外先算人。Deadline 照舊。態度可以再傾。"
    },
    "ending_f": {
      "id": "ending_f",
      "ending": true,
      "label": "結局 F",
      "endingTitle": "對峙存檔",
      "text": "「有種。小心。」下季未完。"
    }
  },
